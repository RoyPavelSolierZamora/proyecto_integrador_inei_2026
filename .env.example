# Configuracion de referencia. instalar.ps1 genera un .env real en la raiz del proyecto.
# Nunca guardes contrasenas reales en este archivo ni lo subas con credenciales.

# --- Backend ---------------------------------------------------------------
# El instalador guarda solo estos datos no secretos. La clave se protege localmente con DPAPI.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=epen_codificacion
PGUSER=epen_app
BACKEND_PORT=8080
APP_ORIGIN=http://127.0.0.1:5174
SESSION_HOURS=8
DB_SSL=disable
NODE_ENV=development

# --- Motores ---------------------------------------------------------------
# La instalación completa utiliza R3 + Ollama y el servicio R2 configurado.
QWEN_MODE=real
QWEN_MODEL=qwen3:4b-instruct-2507-q4_K_M
R3_BASE_URL=http://127.0.0.1:8000
R2_BASE_URL=http://127.0.0.1:8100
R2_BATCH_SIZE=100
R2_TIMEOUT_SECONDS=120
