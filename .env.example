# Configuracion de referencia. instalar.ps1 genera un .env real en la raiz del proyecto.
# Nunca guardes contrasenas reales en este archivo ni lo subas con credenciales.

# --- Interfaz (Vite) -------------------------------------------------------
VITE_AUTH_MODE=demo
VITE_DATA_MODE=demo

# --- Backend ---------------------------------------------------------------
# Para PostgreSQL real usa DATABASE_URL o las variables PG*.
DATABASE_URL=postgresql://epen_app:CAMBIAR_CLAVE@127.0.0.1:5432/epen_codificacion
BACKEND_PORT=8080
APP_ORIGIN=http://127.0.0.1:5174
SESSION_HOURS=8
DB_SSL=disable
NODE_ENV=development

# --- Motores ---------------------------------------------------------------
# demo = respuestas simuladas; real = R3 + Ollama + microservicio R2.
QWEN_MODE=demo
R3_BASE_URL=http://127.0.0.1:8000
R2_BASE_URL=http://127.0.0.1:8100
R2_BATCH_SIZE=100
R2_TIMEOUT_SECONDS=120
